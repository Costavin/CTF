N = 

p_hi = 2615850379731327725778203313365784512838922702185011257029931947846122736769634242897120915009678837272252972592332233245419497072070

p_known = p_hi << 72
R.<x> = PolynomialRing(Zmod(N))
f = p_known + x
roots = f.small_roots(X=2^72, beta=0.3, epsilon=0.01)
if roots:
    x0 = roots[0]
    p = p_known + Integer(x0)
    print(f"Recovered p: {p}")
    print(f"Factor q: {N // p}")
    print(f"Root value: {x0}")
else:
    print("Could not recover p.")



