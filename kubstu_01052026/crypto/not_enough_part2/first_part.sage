N = 
p_hi = 8323136952560429531827321572791762454121167757363054897308938675603963868132925956974213137032081376425627149514834712272012976728

for shift_ in range(1,300): 
	p_known = p_hi << shift_
	R.<x> = PolynomialRing(Zmod(N))
	f = p_known + x
	roots = f.small_roots(X=2^shift_, beta=0.2, epsilon=0.05)
	if roots:
	    x0 = roots[0]
	    p = p_known + Integer(x0)
	    print(f"Recovered p: {p}")
	    print(f"Factor q: {N // p}")
	    print(f"Root x0: {x0}")
	    break
	else:
	    print(f"Could not recover p. for shift: {shift_}")




