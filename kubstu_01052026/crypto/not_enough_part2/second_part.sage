#N_old = 
N = 
p_hi = 2473957629125585196443465742830204773124470235023864499097528953490681406006927518435938920617611579924972782017848204307269253415431


def compute():
	p_high = p_hi << 72
	R.<x> = PolynomialRing(Zmod(N))
	f = p_high + x
	roots = f.small_roots(X=2^72, beta=0.4, epsilon=0.02)
	if roots:
		x0 = roots[0]
		p = p_high + Integer(x0)
		print(f"Recovered p: {p}")
		print(f"Factor q: {N // p}")
		print(f"Root x0: {x0}")
		
	else:
		print(f"Could not recover p")

compute()
